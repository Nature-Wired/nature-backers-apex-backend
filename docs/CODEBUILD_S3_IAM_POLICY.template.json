{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_SOURCE_BUCKET/REPLACE_EXACT_OBJECT_KEY"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:logs:us-west-2:296903956631:log-group:/aws/codebuild/nature-backers-sports-smoke"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-2:296903956631:log-group:/aws/codebuild/nature-backers-sports-smoke:*"
    }
  ]
}
