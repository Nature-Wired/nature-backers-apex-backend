generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SDG {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  projects ProjectSDG[]
}

model Project {
  id                       Int               @id @default(autoincrement())
  created_at               DateTime          @default(now())
  latitude                 Float?
  longitude                Float?
  primarySector            String?
  projectMethodology       String?
  projectName              String?
  projectTypes             String?
  proofPurpose             String?
  secondarySector          String?
  uniqueId                 String            @unique
  verificationMethod       String?
  consensusTimestamp       String?
  status                   String?
  impactAndRiskAssessments Json?
  impactAndRiskSdgs        Json?
  standards                Json?
  CampaignProject          CampaignProject[]
  sdgs                     ProjectSDG[]
  votes                    Vote[]

  @@unique([projectName, uniqueId])
}

model ProjectSDG {
  projectId Int
  sdgId     Int
  project   Project @relation(fields: [projectId], references: [id])
  sdg       SDG     @relation(fields: [sdgId], references: [id])

  @@id([projectId, sdgId])
}

model Campaign {
  id                 Int                  @id @default(autoincrement())
  name               String
  votingStyle        VotingStyle
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  emailBody          String?
  emailSubject       String?
  url                String?
  campaignStatusId   Int
  tx_hash            String?
  campaignStatus     CampaignStatus       @relation(fields: [campaignStatusId], references: [id])
  CampaignDepartment CampaignDepartment[]
  CampaignProject    CampaignProject[]
  payouts            Payout[]
  votes              Vote[]
  volunteers         Volunteer[]

  @@unique([name, startDate, endDate, votingStyle])
}

model CampaignProject {
  id         Int      @id @default(autoincrement())
  campaignId Int
  projectId  Int
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([campaignId, projectId])
}

model CampaignDepartment {
  id           Int        @id @default(autoincrement())
  campaignId   Int
  departmentId Int
  createdAt    DateTime   @default(now())
  campaign     Campaign   @relation(fields: [campaignId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([campaignId, departmentId])
}

model Payout {
  id         Int      @id @default(autoincrement())
  campaignId Int
  txId       String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, txId])
}

model FilterCategory {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  label     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  options   FilterOption[]
}

model FilterOption {
  id               Int            @id @default(autoincrement())
  value            String
  label            String
  filterCategoryId Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  filterCategory   FilterCategory @relation(fields: [filterCategoryId], references: [id])

  @@unique([filterCategoryId, value])
}

model Department {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  CampaignDepartment CampaignDepartment[]
  users              User[]
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model CampaignStatus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model User {
  id              Int         @id @default(autoincrement())
  google_sub      String?     @unique
  email_verified  Boolean     @default(false)
  profile_picture String?
  id_token        String?
  id_token_expiry DateTime?
  access_token    String?
  refresh_token   String?
  role_id         Int?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @default(now())
  departmentId    Int?
  business_email  String      @unique
  first_name      String
  last_name       String
  personal_email  String?
  department      Department? @relation(fields: [departmentId], references: [id])
  role            Role?       @relation(fields: [role_id], references: [id])
  votes           Vote[]
  volunteers      Volunteer[]
}

model Volunteer {
  id         Int      @id @default(autoincrement())
  userId     Int
  campaignId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([userId, campaignId])
}

model Vote {
  id         Int      @id @default(autoincrement())
  userId     Int
  campaignId Int
  voteData   Json?
  createdAt  DateTime @default(now())
  projectId  Int
  vote_hash  String?
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, campaignId])
}

enum VotingStyle {
  TOKEN_BASED
  STORY_FEATURE
  THEMED_BADGES
}

// Sports-only persistence: no relations to legacy Campaign, Project, User or Vote.
enum SportsCampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model SportsCampaign {
  id                  String               @id @default(uuid()) @db.Uuid
  slug                String               @unique
  name                String
  league              String?
  team                String?
  sponsor             String?
  event               String
  venue               String?
  partners            Json?
  startsAt            DateTime
  endsAt              DateTime
  status              SportsCampaignStatus @default(DRAFT)
  commitmentAmount    Decimal?             @db.Decimal(18, 2)
  commitmentCurrency  String?              @db.VarChar(3)
  rewardType          String               @default("DIGITAL_BADGE")
  rewardConfig        Json
  publishedAt         DateTime?
  createdBySubject    String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ballot              SportsBallotProject[]
  selections          FanSelection[]
}

model AtlasProject {
  id              Int                  @id @default(autoincrement())
  sourceTimestamp String               @unique
  metadata        Json
  fetchedAt       DateTime
  ballot          SportsBallotProject[]
}

model SportsBallotProject {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @db.Uuid
  atlasProjectId Int
  position       Int
  snapshot       Json
  campaign       SportsCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  atlasProject   AtlasProject   @relation(fields: [atlasProjectId], references: [id], onDelete: Restrict)
  selections     FanSelection[]

  @@unique([campaignId, atlasProjectId])
  @@unique([campaignId, position])
  @@unique([id, campaignId])
}

model FanSelection {
  id             String              @id @default(uuid()) @db.Uuid
  campaignId     String              @db.Uuid
  ballotProjectId String             @db.Uuid
  participantHash String
  idempotencyKey  String             @db.Uuid
  createdAt      DateTime            @default(now())
  campaign       SportsCampaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  ballotProject  SportsBallotProject @relation(fields: [ballotProjectId, campaignId], references: [id, campaignId], onDelete: Restrict)
  reward         RewardIssuance?

  @@unique([campaignId, participantHash])
  @@unique([campaignId, idempotencyKey])
  @@index([campaignId, ballotProjectId])
}

model RewardIssuance {
  id              String       @id @default(uuid()) @db.Uuid
  selectionId     String       @unique @db.Uuid
  rewardType      String
  snapshot        Json
  claimKeyVersion String
  issuedAt        DateTime     @default(now())
  selection       FanSelection @relation(fields: [selectionId], references: [id], onDelete: Restrict)
}
